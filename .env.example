# ──────────────────────────────────────────────────────────────────
# Calzados Backend – Variables de entorno
# Copiá este archivo a .env y completá los valores
# ──────────────────────────────────────────────────────────────────

# ── Servidor ────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Supabase ────────────────────────────────────────────────────────
# Encontrás estos valores en: Settings → API de tu proyecto Supabase
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# La service role key tiene permisos de admin (omite RLS).
# Nunca la expongas en el frontend.

# ── JWT ─────────────────────────────────────────────────────────────
# Generá un secret seguro: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# ── CORS ────────────────────────────────────────────────────────────
# URL del frontend (sin barra al final)
CORS_ORIGIN=http://localhost:5173
